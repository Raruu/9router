# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
# ENABLE_REQUEST_LOGS gates the open-sse file logger (open-sse/utils/requestLogger.js → ./logs).
# Dashboard request-details recording uses OBSERVABILITY_* below instead.
ENABLE_REQUEST_LOGS=false
# Opt-in fallback for the requestDetails table, used only until the Profile →
# Observability toggle has been switched once (stored setting then wins).
OBSERVABILITY_ENABLED=true
# Retention window in days for requestDetails (0 disables age-based pruning).
OBSERVABILITY_RETENTION_DAYS=60
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Optional OAuth background-refresh pacing (defaults shown; all opt-in).
# Refreshes run as one sequential queue with jitter so multiple accounts never
# burst a provider from one IP — Google Cloud anti-abuse shadow-restricts on that.
# Delay after each refreshed account, skipped after the last one. A value of 0
# is not honoured (it falls back to the default):
# BG_REFRESH_GOOGLE_DELAY_MS=12000   # antigravity, gemini-cli (plus 0-4s jitter)
# BG_REFRESH_DELAY_MS=1500           # every other provider (plus a flat 200ms)
# Kill switch for the whole scheduler (accepts 1/true/yes/on):
# DISABLE_BACKGROUND_TOKEN_REFRESH=false
# The antigravity/gemini-cli project id resolves lazily, on the request that
# needs it. Must be the literal "true" to restore an eager fetch per refresh.
# EAGER_PROJECT_ID_REFRESH=false
# onboardUser retries while the project id isn't ready (plus 0-5s jitter/wait):
# ONBOARD_MAX_ATTEMPTS=2
# ONBOARD_RETRY_DELAY_MS=12000

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Global chat timeouts in milliseconds (per-provider overrides live on each
# provider's dashboard page and take precedence when set).
# Abort if the upstream sends no response headers within this time:
# FETCH_CONNECT_TIMEOUT_MS=60000
# Abort if the first streamed chunk takes longer (streaming only):
# STREAM_FIRST_CHUNK_TIMEOUT_MS=200000
# Abort if no data arrives for this long mid-stream (streaming only):
# STREAM_STALL_TIMEOUT_MS=360000

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
